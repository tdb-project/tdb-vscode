{
  "name": "tdb-vscode",
  "displayName": "The Data-Bridge (TDB)",
  "description": "Connect VS Code agent mode to a TDB MCP server: governed, audited, read-only SQL over your data.",
  "version": "0.1.4",
  "publisher": "tdb-project",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/tdb-project/tdb-vscode"
  },
  "homepage": "https://docs.tdb.jiracorp.co.in/getting-started/ide-setup/",
  "bugs": {
    "url": "https://github.com/tdb-project/tdb-vscode/issues"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Data Science"
  ],
  "keywords": [
    "mcp",
    "sql",
    "audit",
    "agent"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "tdb.mcp",
        "label": "The Data-Bridge (TDB)"
      }
    ],
    "commands": [
      {
        "command": "tdb.connect",
        "title": "Connect to Server",
        "category": "TDB"
      },
      {
        "command": "tdb.disconnect",
        "title": "Disconnect",
        "category": "TDB"
      }
    ],
    "configuration": {
      "title": "The Data-Bridge (TDB)",
      "properties": {
        "tdb.serverUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of the TDB server, e.g. `http://localhost:8000`. Set it with **TDB: Connect to Server**; the API key is kept in VS Code's secret storage, never in settings."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "tsc -p tsconfig.test.json && node esbuild.mjs",
    "test": "vscode-test",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.4",
    "@types/vscode": "1.101.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "ovsx": "1.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@azure/msal-node": "7.1.1",
    "diff": "8.0.3",
    "serialize-javascript": "7.1.4"
  }
}
